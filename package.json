{
  "name": "veritas",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "scan": "bun backend/src/cli.ts scan",
    "api": "bun backend/src/server.ts",
    "api:dev": "bun --watch backend/src/server.ts",
    "web": "bun run --cwd frontend dev",
    "web:build": "bun run --cwd frontend build",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@veritas/shared": "workspace:*"
  }
}
