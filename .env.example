# Copy to .env (git ignores it) and fill in. Bun loads .env automatically.

# Supabase Postgres. In the Supabase dashboard: Connect > Session pooler, copy the URI
# and put your database password in place of [YOUR-PASSWORD].
# Without DATABASE_URL, VERITAS stores data in an embedded Postgres under .veritas/pgdata.
DATABASE_URL=postgresql://postgres.ggngrxrmiacrgchepbpt:[YOUR-PASSWORD]@[POOLER-HOST-FROM-CONNECT]:5432/postgres
